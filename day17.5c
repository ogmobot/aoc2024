#!/usr/bin/env nickle

const MAXPROGLEN = 0x100;
const MAXOUTLEN = 0x100;

typedef (struct {
    int ip; /* instruction pointer */
    int op; /* output pointer */
    int a;  /* register A */
    int b;  /* register B */
    int c;  /* register C */
    int pl; /* length of program */
    int[MAXPROGLEN] prog;
    int[MAXOUTLEN] output;
}) cpu_t;

void reset_vm(*cpu_t cpu, int a, int b, int c) {
    /* Mutates cpu */
    for (int i = 0; i < MAXOUTLEN; i++)
        cpu->output[i] = -1;
    cpu->ip = 0;
    cpu->op = 0;
    cpu->a  = a;
    cpu->b  = b;
    cpu->c  = c;
    return;
}

void step_vm(*cpu_t cpu) {
    /* Mutates cpu */
    int opcode = cpu->prog[cpu->ip++];
    int operand = cpu->prog[cpu->ip++];
    int combo = operand;
    switch (operand) {
    case 4: combo = cpu->a; break;
    case 5: combo = cpu->b; break;
    case 6: combo = cpu->c; break;
    case 7: /* undefined behaviour; do nothing */ break;
    }
    switch (opcode) {
    case 0: /*adv*/ cpu->a >>= combo;                   break;
    case 1: /*bxl*/ cpu->b ^= operand;                  break;
    case 2: /*bst*/ cpu->b = combo & 7;                 break;
    case 3: /*jnz*/ if (0 != cpu->a) cpu->ip = operand; break;
    case 4: /*bxc*/ cpu->b ^= cpu->c;                   break;
    case 5: /*out*/ cpu->output[cpu->op++] = combo & 7; break;
    case 6: /*bdv*/ cpu->b = cpu->a >> combo;           break;
    case 7: /*cdv*/ cpu->c = cpu->a >> combo;           break;
    }
    return;
}

void run_vm(*cpu_t cpu) {
    /* Mutates cpu */
    while (0 <= cpu->ip && cpu->ip < cpu->pl)
        step_vm(cpu);
    return;
}

void print_vm_output(*cpu_t cpu) {
    for (int i = 0; i < cpu->op; i++)
        printf("%d,", cpu->output[i]);
    printf("\b \n");
    return;
}

int match_digit(*cpu_t cpu, int[3] regs, int dig_index) {
    /* matches this digit of the output, then recurses */
    /* dig_index varies from 0 up to cpu->pl - 1 */
    /* Mutates cpu */
    if (dig_index >= cpu->pl)
        return regs[0];
    for (int bits = 0; bits < 8; bits++) {
        int a = regs[0] | (bits << (3 * (cpu->pl - 1 - dig_index)));
        reset_vm(cpu, a, regs[1], regs[2]);
        run_vm(cpu);

        if (cpu->output[cpu->pl - 1 - dig_index]
            == cpu->prog[cpu->pl - 1 - dig_index]
        ) {
            int recurse_result =
                match_digit(cpu, (int[3]){a, regs[1], regs[2]}, dig_index + 1);
            if (recurse_result != -1)
                return recurse_result;
        }
    }
    return -1;
}

/* Initialise vm */

int[3] regs;
string buffer;
file fp = File::open("input17.txt", "r");
File::fscanf(fp, "Register A: %d\n", &regs[0]);
File::fscanf(fp, "Register B: %d\n", &regs[1]);
File::fscanf(fp, "Register C: %d\n\n", &regs[2]);
File::fscanf(fp, "Program: %s\n", &buffer);
File::close(fp);

cpu_t cpu = {ip = 0, op = 0, pl = 0};
for (int i = 0; i < String::length(buffer); i += 2)
    cpu.prog[cpu.pl++] = string_to_integer(String::substr(buffer, i, 1));

/* Part 1 */
reset_vm(&cpu, regs[0], regs[1], regs[2]);
run_vm(&cpu);
print_vm_output(&cpu);

/* Part 2 */
regs[0] = 0;
printf("%d\n", match_digit(&cpu, regs, 0));
