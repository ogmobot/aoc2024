#!/usr/bin/env amber

import { lpad, parse_int, split, split_words, trim } from "std/text"
import { array_pop } from "std/array"

fun minpow(lim: Int, b: Int): Int {
    // returns the smallest power of b larger than lim
    let retval = 1
    while retval <= lim {
        retval *= b
    }
    return retval
}

fun is_valid(orig_line: Text, is_p2: Bool): Bool? {
    const parts = split(orig_line, ":")
    const target = parse_int(parts[0])?
    const val_strings = split_words(trim(parts[1]))
    let vals = [Int]
    for val_string in val_strings {
        vals += [parse_int(val_string)?]
    }
    return rec_is_valid(target, vals, len(vals) - 1, is_p2)
}

fun rec_is_valid(target: Int, nums: [Int], last_i: Int, is_p2: Bool): Bool {
    if last_i == 0 {
        return (target == nums[0])
    }
    const last = nums[last_i]
    if is_p2 {
        const divfactor = minpow(last, 10)
        if target % divfactor == last {
            if rec_is_valid(target / minpow(last, 10), nums, last_i - 1, is_p2):
                return true
        }
    }
    if target % last == 0 {
        if rec_is_valid(target / last, nums, last_i - 1, is_p2):
            return true
    }
    if target  - last >= 0 {
        if rec_is_valid(target - last, nums, last_i - 1, is_p2):
            return true
    }
    return false
}

fun first_int(line: Text): Int? {
    return parse_int($grep -o '^[[:digit:]]\+' <(echo "{line}")$?)?
}

main {
    let total_1 = 0
    let total_2 = 0
    const fname = "input07.txt"
    const linecount = $wc -l < {fname} $? as Text
    for index, line in lines(fname)? {
        echo(lpad(index as Text, " ", 3)+"/"+linecount+" ("+line+")")
        if is_valid(line, false)?:
            total_1 += first_int(line)?
        if is_valid(line, true)?:
            total_2 += first_int(line)?
    }
    echo(total_1)
    echo(total_2)
}
