module aoc2024.day11

import std.prelude
import std.array
import std.byte
import std.file
import std.list
import std.map
import std.maybe
import std.result
import std.str
import std.world

##############################
# Basic hash table structure #
##############################

struct HashTable(k, v) {
    value-lists: Array(Map(k, v))
    --
    def New [ HashTable(k, v) ] {
        Map.Nil 1024u Array.New >value-lists
        HashTable
    }
    ||| Insertion and retrieval both require the caller to provide
    ||| a matching hash function. Providing a different hash function
    ||| may prevent retrieval.
    def insert(hashfn) [
        ( k -- U16 ) KeyValuePair(k, v) HashTable(k, v)
        --
        HashTable(k, v)
    ] {
        over pair drop hashfn \hash
        # ( kv ht )
        # this dup is gonna hurt performance if it dups the whole array...
        dup dip(
            @hash swap get-internal-alist insert
        )
        # ( alist ht )
        @hash >Nat swap value-lists:set
    }
    def get(hashfn, keq) [
        ( k -- U16, k k -- Bool )
        k HashTable(k, v) -- Maybe(v)
    ] {
        over hashfn
        swap get-internal-alist
        lookup(keq)
    }
    def get-internal-alist [ U16 HashTable(k, v) -- Map(k, v) ] {
        value-lists dip(>Nat) get
    }
}

def hashInt2 [ [Int Int] -- U16 ] {
    unpack2 +
    1024 divmod nip
    >U16-wrap
}

#########################
# Stone-splitting logic #
#########################

def smallest-power-of-ten [ Int -- Int ] {
    # Find the smallest power of ten LARGER than n
    1
    while(over over >=, 10 *)
    nip
}

def count-digits [ Int -- Int ] {
    smallest-power-of-ten
    -1 swap
    while (dup 0>, swap 1+ swap 10 divmod drop)
    drop
    # (Note -- by this logic, 0 has 0 digits...)
}

def split-in-half [ Int -- Int Int ] {
    dup count-digits 2 divmod drop
    1 while(over 0>, 10 * swap 1- swap)
    nip
    divmod
}

def digits-even? [ Int -- Bool ] {
    # Return whether an integer has an even amount of digits
    count-digits
    2 divmod nip 0=
}

def one-step [ Int -- List(Int) ] {
    # Output list could be of length 1 or length 2.
    dup 0= if(
        1+ List.L1,
        dup digits-even? if(
            split-in-half List.L2,
            2024 * List.L1))
}

def sum-solns [
    HashTable([Int Int], Int) [Int Int] -- HashTable([Int Int], Int) Int
] {
    # Given [ stone repeats ],
    # Finds the sum of [ stone' repeats-1 ] for each stone' in one-step
    unpack2 swap one-step
    map(over 1- pack2)
    nip
    map(n-steps)
    sum(+) unwrap(-1)
}

def n-steps [
    HashTable([Int Int], Int) [Int Int] -- HashTable([Int Int], Int) Int
] {
    # ( cache [stone repeats] -- cache' result )
    dup unpack2 nip 0= if(
        drop 1,
        dup2 swap get(hashInt2, pack2=(=, =)) dup if(
            # ( cache [stone repeats] Some(soln) )
            unwrap(0) nip,
            # ( cache [stone repeats] None )
            drop swap over sum-solns
            # ( [stone repeats] cache soln )
            dup dip(dip(swap) KeyValuePair.Pair swap insert(hashInt2))))
}

#####################
# Parsing functions #
#####################

def parse-nat [ Str -- Nat ] {
    0 swap
    bytes-for(dup is-digit if(dip(10 *) >Int 48 - +, drop))
    >Nat-unsafe
}

def parse-into-list [ Str -- List(Int) ] {
    split-byte(Byte.BSPACE =) >List
    # Mirth does not yet have functions for parsing Str to Int,
    # or converting F64 to Int.
    map(parse-nat >Int)
}

#################
# Main function #
#################

def main {
    "input11.txt" >Path std.prim.+World.read-path! then(
        parse-into-list
        dup

        HashTable.New
        # Part 1
        swap map(25 pack2 n-steps) sum(+) unwrap(-1) >Str print
        # Part 2 (takes ~15s)
        swap map(75 pack2 n-steps) sum(+) unwrap(-1) >Str print
        drop
    )
}
