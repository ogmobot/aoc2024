func getadj {row col} {
    return [list [list [expr $row + 1] $col] [list [expr $row - 1] $col] \
                 [list $row [expr $col + 1]] [list $row [expr $col - 1]]]
}

func floodfill {grid visited row col} {
    set region [list]
    set front [list [list $row $col]]
    while {[expr [count $front] > 0]} {
        # pop
        lmap [index $front 0] r c
        set front [slice $front 1]

        if not [grid-set $visited $r $c] {
            [grid-set $visited $r $c 1]
            append region [list $r $c]
            foreach adj [getadj $r $c] {
                lmap $adj ar ac
                if [streq [grid-set $grid $r $c] [grid-set $grid $ar $ac]] {
                    append front [list $ar $ac]
                }
            }
        }
    }
    return $region
}

func perimeter {grid region} {
    # for each coord in the region, count adjacent cells that don't match
    set total 0
    foreach coord $region {
        lmap $coord r c
        foreach adj [getadj $r $c] {
            lmap $adj ar ac
            if not [streq [grid-set $grid $r $c] [grid-set $grid $ar $ac]] {
                inc total
            }
        }
    }
    return $total
}

func price {grid region} {
    return [expr [perimeter $grid $region] * [count $region]]
}

func countcorners {grid row col} {
    set corners 0
    set myself [grid-set $grid $row $col]
    # numpad logic
    set c1 [streq $myself [grid-set $grid [expr $row + 1] [expr $col - 1]]] \
        c2 [streq $myself [grid-set $grid [expr $row + 1]       $col     ]] \
        c3 [streq $myself [grid-set $grid [expr $row + 1] [expr $col + 1]]] \
        c4 [streq $myself [grid-set $grid       $row      [expr $col - 1]]] \
        c6 [streq $myself [grid-set $grid       $row      [expr $col + 1]]] \
        c7 [streq $myself [grid-set $grid [expr $row - 1] [expr $col - 1]]] \
        c8 [streq $myself [grid-set $grid [expr $row - 1]       $col     ]] \
        c9 [streq $myself [grid-set $grid [expr $row - 1] [expr $col + 1]]]

    ## convex corners
    inc corners [expr !( $c8 || $c4 ) + !($c8 || $c6 ) \
                    + !( $c2 || $c4 ) + !($c2 || $c6 )]
    ## concave corner
    inc corners [expr !!($c8 && $c4 && !$c7 ) + !!($c8 && $c6 && !$c9 ) \
                    + !!($c2 && $c4 && !$c1 ) + !!($c2 && $c6 && !$c3 )]
    return $corners
}


func ncorners {grid region} {
    set total 0
    foreach coord $region {
        lmap $coord r c
        inc total [countcorners $grid $r $c]
    }
    return $total
}

func discounted {grid region} {
    return [expr [ncorners $grid $region] * [count $region]]
}

func find-regions {grid visited} {
    set regions [list]
    for {set r 0} {[expr $r < [grid-height $grid]]} {inc r} {
        for {set c 0} {[expr $c < [grid-width $grid]]} {inc c} {
            if not [grid-set $visited $r $c] {
                append regions [floodfill $grid $visited $r $c]
            }
        }
    }
    return $regions
}

func main {fname} {
    set grid [grid-make [trim [read $fname]]]

    # floodfill regions (takes ~1 min)
    # (I'm not going to worry about the inefficiency of reading input twice!)
    set visited [grid-make [trim [read $fname]] 0]
    set regions [find-regions $grid $visited]
    grid-free $visited

    # part 1 (takes ~30s)
    set total 0
    foreach region $regions {
        inc total [price $grid $region]
    }
    print $total
    #part 2 (takes ~20s)
    set total 0
    foreach region $regions {
        inc total [discounted $grid $region]
    }
    print $total

    grid-free $grid
    return
}

main input12.txt
