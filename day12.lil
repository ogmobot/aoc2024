# Represent each region as a list of row@col

# Utility functions

func or args {
    foreach [slice $args 1] {
        upeval "downeval \"set v \"\[${i}\]"
        if $v { return 1 }
    }
    return 0
}

func and args {
    foreach [slice $args 1] {
        upeval "downeval \"set v \"\[${i}\]"
        if not $v { return 0 }
    }
    return 1
}

# This isn't needed, since lookup out-of-bounds returns empty string
# func oob {grid coord} {
#     lmap [split $coord @] row col
#     # use count for lists and length for strings
#     return [or {expr $row < 0} {expr $row >= [count $grid]} \
#                {expr $col < 0} {expr $col >= [length [index $grid $row]]}]
# }

func gridget {grid row col} {
    return [charat [index $grid $row] $col]
}

# Functions to keep track of visited cells
# (TODO implement these in C and build a wrapper)
# Usage:
#   mapset my-grid 2@3 foo
#   mapget my-grid 2@3     # => foo

func mapset {mapname key value} {
    set varname "M"$mapname"@"$key
    upeval "set $varname $value"
}
func mapget {mapname key} {
    set "M"$mapname"@"$key
}

# Main program logic

func getadj {row col} {
    return [list [list [expr $row + 1] $col] [list [expr $row - 1] $col] \
                 [list $row [expr $col + 1]] [list $row [expr $col - 1]]]
}

func floodfill {grid row col} {
    set region [list]
    set front [list [list $row $col]]
    while {[expr [count $front] > 0]} {
        # pop
        lmap [index $front 0 ] r c
        set front [slice $front 1]
        if not [mapget visited $r"@"$c] {
            topeval "mapset visited "$r"@"$c" 1"
            append region [list $r $c]
            foreach adj [getadj $r $c] {
                lmap $adj ar ac
                if [streq [gridget $grid $r $c] [gridget $grid $ar $ac]] {
                    append front [list $ar $ac]
                }
            }
        }
    }
    return $region
}

func perimeter {grid region} {
    # for each coord in the region, count adjacent cells that don't match
    set total 0
    foreach coord $region {
        lmap $coord r c
        foreach adj [getadj $r $c] {
            lmap $adj ar ac
            if not [streq [gridget $grid $r $c] [gridget $grid $ar $ac]] {
                inc total
            }
        }
    }
    return $total
}

func price {grid region} {
    return [expr [perimeter $grid $region] * [count $region]]
}

func countcorners {grid row col} {
    set corners 0
    set myself [gridget $grid $row $col]
    # numpad logic
    set c1 [gridget $grid [expr $row + 1] [expr $col - 1]] \
        c2 [gridget $grid [expr $row + 1]       $col     ] \
        c3 [gridget $grid [expr $row + 1] [expr $col + 1]] \
        c4 [gridget $grid       $row      [expr $col - 1]] \
        c5 [gridget $grid       $row            $col     ] \
        c6 [gridget $grid       $row      [expr $col + 1]] \
        c7 [gridget $grid [expr $row - 1] [expr $col - 1]] \
        c8 [gridget $grid [expr $row - 1]       $col     ] \
        c9 [gridget $grid [expr $row - 1] [expr $col + 1]]
    ## convex corners
    # top left
    if not [or {streq $myself $c8} {streq $myself $c4}] {
        inc corners
    }
    # top right
    if not [or {streq $myself $c8} {streq $myself $c6}] {
        inc corners
    }
    # bottom left
    if not [or {streq $myself $c2} {streq $myself $c4}] {
        inc corners
    }
    # bottom right
    if not [or {streq $myself $c2} {streq $myself $c6}] {
        inc corners
    }
    ## concave corners
    # top left
    if [and {streq $myself $c8} {streq $myself $c4} {strcmp $myself $c7}] {
        inc corners
    }
    # top right
    if [and {streq $myself $c8} {streq $myself $c6} {strcmp $myself $c9}] {
        inc corners
    }
    # bottom left
    if [and {streq $myself $c2} {streq $myself $c4} {strcmp $myself $c1}] {
        inc corners
    }
    # bottom right
    if [and {streq $myself $c2} {streq $myself $c6} {strcmp $myself $c3}] {
        inc corners
    }

    return $corners
}

func ncorners {grid region} {
    set total 0
    foreach coord $region {
        lmap $coord r c
        inc total [countcorners $grid $r $c]
    }
    return $total
}

func discounted {grid region} {
    return [expr [ncorners $grid $region] * [count $region]]
}

func main {fname} {
    set grid [split [trim [read $fname]] "\n"]
    set regions [list]
    for {set r 0} {[expr $r < [count $grid]]} {inc r} {
        for {set c 0} {[expr $c < [length [index $grid $r]]} {inc c} {
            if not [mapget visited $r"@"$c] {
                append regions [floodfill $grid $r $c]
            }
        }
    }
    # part 1 (takes ~30 min)
    set total 0
    foreach region $regions {
        inc total [price $grid $region]
    }
    print $total
    #part 2 (takes ~50 more min)
    set total 0
    foreach region $regions {
        inc total [discounted $grid $region]
    }
    print $total
}

main input12.txt
