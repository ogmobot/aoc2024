# Represent each region as a list of row@col

# Utility functions

func or args {
    foreach [slice $args 1] {
        upeval "downeval \"set v \"\[${i}\]"
        if $v { return 1 }
    }
    return 0
}

func and args {
    foreach [slice $args 1] {
        upeval "downeval \"set v \"\[${i}\]"
        if not $v { return 0 }
    }
    return 1
}

# This isn't needed, since lookup out-of-bounds returns empty string
# func oob {grid coord} {
#     lmap [split $coord @] row col
#     # use count for lists and length for strings
#     return [or {expr $row < 0} {expr $row >= [count $grid]} \
#                {expr $col < 0} {expr $col >= [length [index $grid $row]]}]
# }

func gridget {grid row col} {
    return [charat [index $grid $row] $col]
}

func find-linear-index {grid row col} {
    return [expr ( $row * [count $grid] ) + $col]
}

# Main program logic

func getadj {row col} {
    return [list [list [expr $row + 1] $col] [list [expr $row - 1] $col] \
                 [list $row [expr $col + 1]] [list $row [expr $col - 1]]]
}

func floodfill {grid visited row col} {
    set region [list]
    set front [list [list $row $col]]
    while {[expr [count $front] > 0]} {
        # pop
        lmap [index $front 0] r c
        set di [find-linear-index $grid $r $c]
        set front [slice $front 1]
        if not [darray $visited $di] {
            [darray $visited $di 1]
            append region [list $r $c]
            foreach adj [getadj $r $c] {
                lmap $adj ar ac
                if [streq [gridget $grid $r $c] [gridget $grid $ar $ac]] {
                    append front [list $ar $ac]
                }
            }
        }
    }
    return $region
}

func perimeter {grid region} {
    # for each coord in the region, count adjacent cells that don't match
    set total 0
    foreach coord $region {
        lmap $coord r c
        foreach adj [getadj $r $c] {
            lmap $adj ar ac
            if not [streq [gridget $grid $r $c] [gridget $grid $ar $ac]] {
                inc total
            }
        }
    }
    return $total
}

func price {grid region} {
    return [expr [perimeter $grid $region] * [count $region]]
}

func countcorners {grid row col} {
    set corners 0
    set myself [gridget $grid $row $col]
    # numpad logic
    set c1 [streq $myself [gridget $grid [expr $row + 1] [expr $col - 1]]] \
        c2 [streq $myself [gridget $grid [expr $row + 1]       $col     ]] \
        c3 [streq $myself [gridget $grid [expr $row + 1] [expr $col + 1]]] \
        c4 [streq $myself [gridget $grid       $row      [expr $col - 1]]] \
        c6 [streq $myself [gridget $grid       $row      [expr $col + 1]]] \
        c7 [streq $myself [gridget $grid [expr $row - 1] [expr $col - 1]]] \
        c8 [streq $myself [gridget $grid [expr $row - 1]       $col     ]] \
        c9 [streq $myself [gridget $grid [expr $row - 1] [expr $col + 1]]]

    ## convex corners
    inc corners [expr !( $c8 || $c4 ) + !($c8 || $c6 ) \
                    + !( $c2 || $c4 ) + !($c2 || $c6 )]
    ## concave corners
    inc corners [expr (!!$c8 && !!$c4 && !$c7 ) + (!!$c8 && !!$c6 && !$c9 ) \
                    + (!!$c2 && !!$c4 && !$c1 ) + (!!$c2 && !!$c6 && !$c3 )]
    return $corners
}


func ncorners {grid region} {
    set total 0
    foreach coord $region {
        lmap $coord r c
        inc total [countcorners $grid $r $c]
    }
    return $total
}

func discounted {grid region} {
    return [expr [ncorners $grid $region] * [count $region]]
}

func find-regions {grid} {
    set visited [make-darray]
    set regions [list]
    for {set r 0} {[expr $r < [count $grid]} {inc r} {
        for {set c 0} {[expr $c < [length [index $grid $r]]} {inc c} {
            if not [darray $visited [find-linear-index $grid $r $c]] {
                append regions [floodfill $grid $visited $r $c]
            }
        }
    }
    free-darray $visited
    return $regions
}

func main {fname} {
    set grid [split [trim [read $fname]] "\n"]
    set regions [find-regions $grid] # This alone takes ~12 min
    # part 1 (takes ~30 min)
    set total 0
    foreach region $regions {
        inc total [price $grid $region]
    }
    print $total
    #part 2 (takes ~50 more min)
    set total 0
    foreach region $regions {
        inc total [discounted $grid $region]
    }
    print $total
    return
}

main input12.test
