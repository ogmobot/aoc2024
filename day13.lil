#snippet FILE_FORMAT_STR { `Button A: X+%lld, Y+%lld\nButton B: X+%lld, Y+%lld\nPrize: X=%lld, Y=%lld\n` }

const BIGNUM: 10000000000000;

// Import IO functions from cstdio
class @FILE { };
fn fopen (var.cstr pathname, var.cstr mode) => ptr(@FILE) extern;
fn fclose (var.ptr(@FILE) stream) => i32 extern;
fn fscanf (var.ptr(@FILE) stream, cstr...) => i32 extern;

class @augMatrix {
    var.i64 ax; // button A increases X by this much
    var.i64 ay; // button A increases Y by this much
    var.i64 bx; // button B increases X by this much
    var.i64 by; // button B increases Y by this much
    var.i64 px; // the X location of the prize
    var.i64 py; // the Y location of the prize
    /*
        i.e. the augmented matrix
        [ ax bx | px ]
        [ ay by | py ]
    */
    fn solve_linear => [2 x i64] {
        // Find the column vector [a b] that solves the matrix
        var.[2 x i64] res: [0, 0];
        if (@self.ay * @self.bx) != (@self.ax * @self.by) {
            if @self.bx = 0 {
                res: [@self.px / @self.ax, 0];
            } else {
                res[0]: ((@self.bx * @self.py) - (@self.by * @self.px))
                        / ((@self.ay * @self.bx) - (@self.ax * @self.by));
                res[1]: (@self.px - (res[0] * @self.ax)) / @self.bx;
            }
        }
        // If this actually results in a win...
        if ((@self.ax * res[0]) + (@self.bx * res[1])) = @self.px {
            if ((@self.ay * res[0]) + (@self.by * res[1])) = @self.py {
                return res;
            }
        }
        // Otherwise...
        res: [0, 0];
        return res;
    }
};

fn get_next_values(var.ptr(@FILE) fp, var.ptr(@augMatrix) refmatrix) => i32 {
    return fscanf(fp,
        #paste FILE_FORMAT_STR,
        pointerTo refmatrix.ax, pointerTo refmatrix.ay,
        pointerTo refmatrix.bx, pointerTo refmatrix.by,
        pointerTo refmatrix.px, pointerTo refmatrix.py
    );
}

fn solve(var.@string fname) {
    var.[2 x i64] solns: [0, 0];
    var.ptr(@FILE) fp: fopen(fname.cstr(), `r`);
    var.@augMatrix matrix;
    for (
        var.i32 matched: get_next_values(fp, pointerTo(matrix));
        matched = 6;
        matched: get_next_values(fp, pointerTo(matrix));
    ) {
        // part 1
        var.[2 x i64] ab: matrix.solve_linear();
        solns[0] +: (3 * ab[0]) + ab[1];
        // part 2
        matrix.px +: BIGNUM;
        matrix.py +: BIGNUM;
        ab: matrix.solve_linear();
        solns[1] +: (3 * ab[0]) + ab[1];
    }
    fclose(fp);
    print solns[0];
    print solns[1];
}

solve("input13.txt");
