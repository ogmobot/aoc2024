#!/usr/bin/env lilt

#WIDTH : 11
#HEIGHT:  7
WIDTH : 101
HEIGHT: 103

on parse_robot line do
    table ("px","py","vx","vy") dict "p=%i,%i v=%i,%i" parse line
end

on safety_factor robots do
    prod
    (count select
        where (px < floor WIDTH / 2) & (py < floor HEIGHT / 2) from robots) ,
    (count select
        where (px > floor WIDTH / 2) & (py < floor HEIGHT / 2) from robots) ,
    (count select
        where (px < floor WIDTH / 2) & (py > floor HEIGHT / 2) from robots) ,
    (count select
        where (px > floor WIDTH / 2) & (py > floor HEIGHT / 2) from robots)
end

on tree? robots do
    midx : floor WIDTH / 2
    midy : floor HEIGHT / 2
    400 < count select
            where (px > midx - 40) & (px < midx + 40)
                & (py > midy - 40) & (py < midy + 40)
            from robots
end

on ascii_grid robots do
    coord_dict : 1 fill (range @ select px py from robots) dict nil
    each y in range HEIGHT
        show["" fuse each x in range WIDTH
            if coord_dict[x,y] "@" else "." end
        end]
    end
end

on main fname do
    # parse input
    text : read[fname]
    while (last text) = "\n"
        text : -1 drop text
    end
    robots : insert px py vx vy with end
    each line in "\n" split text
        robots : robots , parse_robot[line]
    end

    # simulate robots
    counter : 0
    while !(part1 & part2)
        robots : update px : WIDTH % px + vx py : HEIGHT % py + vy from robots
        counter : counter + 1
        if !part1
            if counter = 100
                part1 : safety_factor[robots]
            end
        end
        if !part2
            if tree?[robots]
                part2 : counter
                #ascii_grid[robots]
            end
        end
    end
    print[part1]
    print[part2]
end

main["input14.txt"]
