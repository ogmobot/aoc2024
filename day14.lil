#!/usr/bin/env lilt

#WIDTH : 11
#HEIGHT:  7
WIDTH : 101
HEIGHT: 103

on parse_robot line do
    table ("px","py","vx","vy") dict "p=%i,%i v=%i,%i" parse line
end

on safety_factor robots do
    prod
    (count select
        where (px < floor WIDTH / 2) & (py < floor HEIGHT / 2) from robots) ,
    (count select
        where (px > floor WIDTH / 2) & (py < floor HEIGHT / 2) from robots) ,
    (count select
        where (px < floor WIDTH / 2) & (py > floor HEIGHT / 2) from robots) ,
    (count select
        where (px > floor WIDTH / 2) & (py > floor HEIGHT / 2) from robots)
end

on main fname do
    text : read[fname]
    while (last text) = "\n"
        text : -1 drop text
    end
    robots : insert px py vx vy with end
    each line in "\n" split text
        robots : robots , parse_robot[line]
    end
    each _ in range 100
        robots : update px : WIDTH % px + vx py : HEIGHT % py + vy from robots
    end
    show[safety_factor[robots]]
end

main["input14.txt"]
show[sys.workspace]
