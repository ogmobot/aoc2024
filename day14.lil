#!/usr/bin/env lilt

#WIDTH :11
#HEIGHT: 7
WIDTH :101
HEIGHT:103

on parse_robot line do
    table ("px","py","vx","vy") dict "p=%i,%i v=%i,%i" parse line
end

on safety_factor robots do
    (count select where (px<floor WIDTH/2)&(py<floor HEIGHT/2) from robots)*
    (count select where (px>floor WIDTH/2)&(py<floor HEIGHT/2) from robots)*
    (count select where (px<floor WIDTH/2)&(py>floor HEIGHT/2) from robots)*
    (count select where (px>floor WIDTH/2)&(py>floor HEIGHT/2) from robots)
end

on tree? robots do
    midx:floor WIDTH/2
    midy:floor HEIGHT/2
    (0.9*count robots)<count select
            where (px>midx-45)&(px<midx+45)
                 &(py>midy-45)&(py<midy+45)
            from robots
end

on paint_robots robots img val do
    each r in rows robots
        img[r.px,r.py]:val
    end
    img
end

on paint_grid robots img do
    img:paint_robots[robots img 1]
    if main_canvas
        main_canvas.paste[img]
    else
        each y in range HEIGHT
            show["" fuse each x in range WIDTH
                if img[x,y] "@" else "." end
            end]
        end
    end
    img:paint_robots[robots img 0]
end

on animate_single_step robots img subs delay do
    if main_canvas
        each i in range subs
            rs:update px:WIDTH%px+vx*i/subs py:HEIGHT%py+vy*i/subs from robots
            img:paint_robots[rs img 1]
            main_canvas.paste[img]
            img:paint_robots[rs img 0]
            sleep[delay]
        end
    end
end

on animate_last_steps robots img rewind final_time do
    rs:update px:WIDTH%px-rewind*vx py:HEIGHT%py-rewind*vy from robots
    each i in range rewind
        counter_text.text:"Time: %04i" format final_time+i-rewind
        animate_single_step[rs img 256 2]
        rs:update px:WIDTH%px+vx py:HEIGHT%py+vy from rs
    end
end

on main fname do
    # parse input
    text:if main_canvas
        main_canvas.clear[]
        danger.read[fname]
    else
        read[fname]
    end
    visualiser:image[(WIDTH,HEIGHT)]
    while (last text)="\n"
        text:-1 drop text
    end
    robots:insert px py vx vy with end
    each line in "\n" split text
        robots:robots,parse_robot[line]
    end

    # simulate robots
    counter:0
    while !(part1&part2)
        robots:update px:WIDTH%px+vx py:HEIGHT%py+vy from robots
        counter:counter+1
        if !part1
            if counter=100
                part1:safety_factor[robots]
            end
        end
        if !part2
            if tree?[robots]
                part2:counter
            end
        end
        if main_canvas
            if !100%counter
                paint_grid[robots visualiser]
                counter_text.text:"Time: %04i" format counter
                sleep[1]
            end
        end
    end
    if main_canvas
        animate_last_steps[robots visualiser 2 part2]
        paint_grid[robots visualiser]
        counter_text.text:"Part 1: %i\nPart 2: %i" format part1,part2
    else
        print[part1]
        print[part2]
    end
    robots
end

main["input14.txt"]
